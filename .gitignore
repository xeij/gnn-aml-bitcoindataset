# Data stays out; the served checkpoints (<1 MB each) and benchmark metrics are committed.
data/
artifacts/*
!artifacts/checkpoints/
!artifacts/benchmark/
artifacts/benchmark/*.pt
artifacts/benchmark/*.log
*.pth
*.csv
*.zip
*.log

